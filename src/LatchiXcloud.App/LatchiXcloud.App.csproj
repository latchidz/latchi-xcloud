<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Allows compile validation on non-Windows dev boxes; production build always
         runs on windows-latest in GitHub Actions. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LATCHI-xCLOUD</AssemblyName>
    <RootNamespace>LatchiXcloud.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon\latchi-xcloud.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <InformationalVersion>1.2.0</InformationalVersion>
    <Product>LATCHI xCLOUD</Product>
    <Company>LATCHI</Company>
    <Authors>LATCHI</Authors>
    <Description>Dedicated lightweight Windows client for Xbox Cloud Gaming with integrated Better xCloud.</Description>
    <Copyright>© 2026 LATCHI</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatchiXcloud.Core\LatchiXcloud.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official Better xCloud userscript, byte-identical to the upstream release —
         never modified. bxc-manifest.json records its provenance (§70). -->
    <Content Include="..\..\resources\better-xcloud.user.js" Link="resources\better-xcloud.user.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\resources\bxc-manifest.json" Link="resources\bxc-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same two files are ALSO embedded in the assembly so the single-file
         portable exe is fully self-contained (BundledResources extracts them to the
         data dir on first run when no resources/ folder exists next to the exe). -->
    <EmbeddedResource Include="..\..\resources\better-xcloud.user.js" Link="resources\better-xcloud.user.js" />
    <EmbeddedResource Include="..\..\resources\bxc-manifest.json" Link="resources\bxc-manifest.json" />
  </ItemGroup>

</Project>
