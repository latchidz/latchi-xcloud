<Window x:Class="LatchiXcloud.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:th="clr-namespace:LatchiXcloud.App.Theme"
        Title="LATCHI xCLOUD"
        Width="1180" Height="740" MinWidth="940" MinHeight="560"
        WindowStyle="None" Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- NOTE (v1.0): the WebView2 WPF control is an HwndHost — plain WPF elements NEVER render
         on top of it (airspace). Every overlay therefore lives in its own HWND: the startup
         splash is a separate window, first-run/errors are dialogs, transient chips are Popups. -->

    <!-- ═══ outer border (visible when windowed, padded when maximized) ═══ -->
    <Border x:Name="OuterBorder" Background="{StaticResource BrushBg}"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ TITLE BAR ═══════════ -->
            <Grid x:Name="TitleBar" Grid.Row="0" Height="38" Background="{StaticResource BrushTitlebar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0">
                    <Path Data="{x:Static th:Icons.Cloud}" Stroke="{StaticResource BrushGold}" StrokeThickness="1.8"
                          Fill="Transparent" Width="17" Height="17" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center"/>
                    <TextBlock Text="LATCHI xCLOUD" Foreground="{StaticResource BrushText}" FontWeight="Bold"
                               FontSize="12.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Better xCloud status chip (clickable — exempted from the caption drag area) -->
                <Border Grid.Column="1" x:Name="ChipBxc" Style="{StaticResource StatusChip}" Margin="12,0,0,0"
                        VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ChipBxc_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="Better xCloud">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ChipDot" Width="7" Height="7" Fill="{StaticResource BrushMuted}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChipText" Text="Better xCloud…" FontSize="11.5"
                                   Foreground="{StaticResource BrushMuted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- toolbar — EVERY button must be mouse-clickable: the whole bar is exempted
                     from the WindowChrome caption drag area (v1.2 mouse fix) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnHome" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.Home}" Click="BtnHome_Click"/>
                    <Button x:Name="BtnReload" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.Reload}" Click="BtnReload_Click"/>
                    <Button x:Name="BtnFullscreen" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.Fullscreen}" Click="BtnFullscreen_Click"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.Settings}" Click="BtnSettings_Click"/>
                    <Button x:Name="BtnDiag" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.Pulse}" Click="BtnDiag_Click"/>
                </StackPanel>

                <!-- window buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Tag="{x:Static th:Icons.Minimize}" Click="BtnMin_Click"/>
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Tag="{x:Static th:Icons.Maximize}" Click="BtnMax_Click"/>
                    <Button x:Name="BtnClose" Style="{StaticResource WinBtn}" Tag="{x:Static th:Icons.Close}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════ CONTENT ═══════════ -->
            <!-- v1.2: the LATCHI brand panel is the visible face of the app until the
                 FIRST navigation starts — the user is never left staring at a bare
                 webview. It is plain WPF and renders because the WebView is Collapsed
                 until then (HwndHost airspace rules). -->
            <Grid Grid.Row="1">
                <StackPanel x:Name="BackPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{x:Static th:Icons.Cloud}" Stroke="{StaticResource BrushGold}" StrokeThickness="1.6"
                          Fill="Transparent" Width="72" Height="72" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock x:Name="BackTitle" Text="LATCHI xCLOUD" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrushText}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BackStatus" Text="جاهز — أكمل الإعداد الأول للبدء"
                               FontSize="13" Foreground="{StaticResource BrushMuted}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
                <wv:WebView2 x:Name="Web" Grid.Row="0" DefaultBackgroundColor="#0A0D14" Visibility="Collapsed"/>
            </Grid>

            <!-- loading overlay — a Popup (own HWND) renders ABOVE the WebView2:
                 "Loading the Microsoft page…" with a soft pulsing icon. Never a
                 silent blank screen again. -->
            <Popup x:Name="LoadingPopup" AllowsTransparency="True" StaysOpen="True" Placement="Relative"
                   PlacementTarget="{Binding ElementName=Web}" IsOpen="False">
                <Border Background="#F20E1320" CornerRadius="12" Padding="34,26" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <StackPanel>
                        <Path x:Name="LoadingIcon" Data="{x:Static th:Icons.Cloud}" Stroke="{StaticResource BrushGold}"
                              StrokeThickness="1.6" Fill="Transparent" Width="34" Height="34" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center">
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25"
                                                             Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <TextBlock x:Name="LoadingText" Text="…" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock x:Name="LoadingSub" Text="" FontSize="11" Foreground="{StaticResource BrushMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- transient chips — Popups (own HWND) so they render above the WebView2 -->
            <Popup x:Name="ExitFsPopup" AllowsTransparency="True" StaysOpen="False" Placement="Relative" PlacementTarget="{Binding ElementName=Web}">
                <Button x:Name="BtnExitFs" Style="{StaticResource BarBtn}" Tag="{x:Static th:Icons.ExitFullscreen}"
                        Width="42" Height="42" Click="BtnExitFs_Click"/>
            </Popup>

            <Popup x:Name="ToastPopup" AllowsTransparency="True" StaysOpen="False" Placement="Relative" PlacementTarget="{Binding ElementName=Web}">
                <Border Background="#F0121826" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                        CornerRadius="9" Padding="16,9" Width="420">
                    <TextBlock x:Name="ToastText" Text="" Foreground="{StaticResource BrushText}" FontSize="12.5"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
