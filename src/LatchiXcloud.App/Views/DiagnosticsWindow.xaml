<Window x:Class="LatchiXcloud.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="التشخيصات — LATCHI xCLOUD"
        Width="620" Height="620" MinWidth="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="{StaticResource BrushBg}"
        FontFamily="{StaticResource AppFont}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" Margin="4"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource GoldBtn}" Content="نسخ التشخيصات" Click="BtnCopy_Click"/>
            <Button Style="{StaticResource GhostBtn}" Content="فتح مجلد السجلات" Margin="10,0,0,0" Click="BtnLogs_Click"/>
            <Button Style="{StaticResource GhostBtn}" Content="إغلاق" Margin="10,0,0,0" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
