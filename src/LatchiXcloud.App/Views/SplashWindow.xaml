<Window x:Class="LatchiXcloud.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:th="clr-namespace:LatchiXcloud.App.Theme"
        Title="LATCHI xCLOUD"
        Width="620" Height="430"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True"
        FlowDirection="LeftToRight"
        FontFamily="{StaticResource AppFont}">

    <!-- The v1.0 splash: always English "Xbox Cloud Gaming" by design (user request).
         Shows the profile picture when the user set one, over the LATCHI brand mark. -->
    <Border x:Name="Root" Background="#0A0D14" CornerRadius="16"
            BorderBrush="#242D42" BorderThickness="1.2" Margin="10"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.94" ScaleY="0.94"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.45"/>
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX"
                                         From="0.94" To="1" Duration="0:0:0.6">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY"
                                         From="0.94" To="1" Duration="0:0:0.6">
                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Halo" Storyboard.TargetProperty="Opacity"
                                         From="0.10" To="0.38" Duration="0:0:1.1" AutoReverse="True"
                                         RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- brand line -->
            <TextBlock Text="L A T C H I   x C L O U D" FontSize="11" FontWeight="SemiBold"
                       Foreground="#8B94A8" HorizontalAlignment="Center" Margin="0,30,0,0" Grid.Row="0"/>

            <!-- emblem: profile picture (if any) inside a glowing ring + LATCHI badge -->
            <Grid Grid.Row="1" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Halo" Width="150" Height="150" Fill="#4CC38A" Opacity="0.14"/>
                <Ellipse Width="128" Height="128" Stroke="#4CC38A" StrokeThickness="2.2"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="128" Height="128" Fill="#0E1320"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- the user's picture (set from code when profile-image exists) -->
                <Image x:Name="Pic" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stretch="UniformToFill" Visibility="Collapsed">
                    <Image.Clip>
                        <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                    </Image.Clip>
                </Image>
                <!-- fallback emblem: the LATCHI cloud -->
                <Path x:Name="Emblem" Data="{x:Static th:Icons.Cloud}" Stroke="#F2C14E" StrokeThickness="1.5"
                      Fill="Transparent" Width="66" Height="66" Stretch="Uniform"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- LATCHI badge pinned to the ring (always visible) -->
                <Border Width="44" Height="44" CornerRadius="22" Background="#0A0D14"
                        BorderBrush="#F2C14E" BorderThickness="1.4"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                    <Path Data="{x:Static th:Icons.Cloud}" Stroke="#F2C14E" StrokeThickness="1.8"
                          Fill="Transparent" Width="19" Height="19" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Border>
            </Grid>

            <!-- title + version + progress -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,34">
                <TextBlock Text="Xbox Cloud Gaming" FontSize="30" FontWeight="Bold" Foreground="#ECEFF6"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionLine" Text="LATCHI xCLOUD" FontSize="11.5" Foreground="#8B94A8"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
                <Grid Width="280" Height="4" Margin="0,18,0,0" HorizontalAlignment="Center">
                    <Border Background="#161D2E" CornerRadius="2"/>
                    <Border x:Name="Bar" Width="92" Height="4" CornerRadius="2" Background="#F2C14E"
                            HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BarMove" X="-96"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="BarMove" Storyboard.TargetProperty="X"
                                                         From="-96" To="284" Duration="0:0:1.5" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
                <TextBlock x:Name="SplashStatus" Text="Connecting to Xbox Cloud Gaming…" FontSize="12"
                           Foreground="#8B94A8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
